diff --git a/app/slug.py b/app/slug.py
index 0ee394d..e778a17 100644
--- a/app/slug.py
+++ b/app/slug.py
@@ -1,8 +1,14 @@
 """Turn a human title into a URL slug."""
 
+import re
+
 MAX_LENGTH = 40
+_NOT_SLUG = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(title):
-    """Lowercase the title and join its words with hyphens."""
-    return title.lower().replace(" ", "-")
+    """Lowercase, collapse every other run to one hyphen, trim, and cap the length."""
+    collapsed = _NOT_SLUG.sub("-", title.lower()).strip("-")
+    if len(collapsed) <= MAX_LENGTH:
+        return collapsed
+    return collapsed[:MAX_LENGTH].rstrip("-")
